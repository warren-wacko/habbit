# Copy this file to .env and fill it in. Never commit .env.

# Port the API listens on
PORT=5000

# PostgreSQL connection string
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/habbit

# A long random string used to sign login tokens. Make one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# Production only. The website's address, so only it can call the API from a browser
# (several can be separated by commas). Locally http://localhost:3000 is allowed already.
# CORS_ORIGIN=https://your-site.vercel.app

# How many proxies sit between the internet and the API (0 locally, 1 on Railway). It decides
# whose address the rate limiter sees: too low and everyone looks the same, too high and an
# attacker can fake an address.
# TRUST_PROXY=1

# Set NODE_ENV=production on the host: the API then refuses to start with a weak JWT_SECRET,
# a missing CORS_ORIGIN or a missing DATABASE_URL.
# NODE_ENV=production

# Local testing only: multiplies every rate limit (for example 100 lets you create many test
# accounts). The API refuses to start in production if this is set to anything but 1.
# RATE_LIMIT_MULTIPLIER=100

# For the automated API tests (npm run test:api). An EMPTY database of its own, never the real one:
# the tests create and delete accounts in it, and refuse to run if it is the same as DATABASE_URL.
# Create it once (for example `createdb -U postgres habbit_test`), then build its tables with:
#   DATABASE_URL=<this address> npx prisma migrate deploy --config prisma7.config.ts
# TEST_DATABASE_URL=postgresql://user:password@localhost:5432/habbit_test
